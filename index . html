<!DOCTYPE html>
<html lang="tl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pilipshop - Online Shop</title>
<style>
body { 
  font-family: Arial; 
  margin: 0; 
  background: #f5f5f5; 
}
header { 
  background: #ff6600; 
  color: white; 
  padding: 20px; 
  text-align: center; 
}
.products { 
  display: grid; 
  grid-template-columns: repeat(2, 1fr); 
  gap: 15px; 
  padding: 20px; 
}
.product { 
  background: white; 
  padding: 15px; 
  border-radius: 10px; 
  text-align: center; 
  box-shadow: 0 2px 5px rgba(0,0,0,0.1); 
}
.product img { 
  width: 100%; 
  height: 150px; 
  object-fit: cover; 
  border-radius: 8px; 
}
button { 
  background: #ff6600; 
  color: white; 
  border: none; 
  padding: 10px; 
  border-radius: 5px; 
  width: 100%; 
  cursor: pointer; 
  font-weight: bold;
}
button:hover { 
  background: #e55a00; 
}
footer { 
  text-align: center; 
  padding: 20px; 
  background: #333; 
  color: white; 
}
</style>
</head>
<body>
<header>
<h1>🛒 PILIPSHOP</h1>
<p>Ang sariling online shop ng Pinoy!</p>
</header>

<div class="products">
<div class="product">
<img src="https://via.placeholder.com/150" alt="T-Shirt">
<h3>T-Shirt</h3>
<p>₱299</p>
<button>Buy Now</button>
</div>

<div class="product">
<img src="https://via.placeholder.com/150" alt="Sapatos">
<h3>Sapatos</h3>
<p>₱899</p>
<button>Buy Now</button>
</div>

<div class="product">
<img src="https://via.placeholder.com/150" alt="Bag">
<h3>Bag</h3>
<p>₱499</p>
<button>Buy Now</button>
</div>

<div class="product">
<img src="https://via.placeholder.com/150" alt="Cap">
<h3>Cap</h3>
<p>₱199</p>
<button>Buy Now</button>
</div>
</div>
<div class="product">
<img src="https://via.placeholder.com/150" alt="Jacket">
<h3>Jacket</h3>
<p>₱1,299</p>
<button>Buy Now</button>
</div>

</div>

<footer>
<p>© 2026 Pilipshop. Gawa ni Kuya ❤️</p>
</footer>
</body>
</html>
